{
  "name": "@blockquote-playground/blk-reference-target",
  "version": "1.0.0-rc.1",
  "description": "Webcomponent blk-reference-target following open-wc recommendations",
  "keywords": [
    "web-components",
    "custom-elements",
    "reference-target",
    "aria",
    "accessibility",
    "a11y",
    "lit"
  ],
  "license": "MIT",
  "author": "blk-reference-target",
  "type": "module",
  "exports": {
    ".": {
      "workspaces": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./BlkReferenceTarget.js": {
      "workspaces": "./src/BlkReferenceTarget.ts",
      "types": "./dist/BlkReferenceTarget.d.ts",
      "default": "./dist/BlkReferenceTarget.js"
    },
    "./blk-reference-target.js": {
      "workspaces": "./src/define/blk-reference-target.ts",
      "types": "./dist/define/blk-reference-target.d.ts",
      "default": "./dist/define/blk-reference-target.js"
    },
    "./index.js": {
      "workspaces": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blk-reference-target-styles.css.js": {
      "workspaces": "./src/styles/blk-reference-target-styles.css.ts",
      "types": "./dist/styles/blk-reference-target-styles.css.d.ts",
      "default": "./dist/styles/blk-reference-target-styles.css.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "files": [
    "/src/",
    "/dist/"
  ],
  "scripts": {
    "analyze": "cem analyze --litelement --globs \"src/**/*.{js,ts}\" \"index.js\"",
    "build": "npm run build:lib && npm run build:tsc",
    "build:demo": "npm run dev:vite",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:tsc": "tsc",
    "dev:vite": "vite build",
    "format": "npm run format:eslint && npm run format:prettier && npm run format:stylelint",
    "format:eslint": "eslint . --fix",
    "format:prettier": "prettier \"**/*.{js,ts,css,scss,html,json}\" --write --ignore-path .prettierignore",
    "format:stylelint": "stylelint \"{demo,src}/**/*.{js,ts,css,scss,html}\" --fix --ignore-path .prettierignore",
    "prepare": "husky",
    "preview:vite": "vite preview",
    "sass:watch": "sass-style-template -j ts",
    "sort:package": "npx sort-package-json",
    "start": "concurrently -k -r \"npm:vite\" \"npm:sass:watch\"",
    "test": "vitest",
    "test:watch": "vitest --browser.headless=false",
    "vite": "vite"
  },
  "lint-staged": {
    "**/*.{js,ts,html}": [
      "npm run format"
    ],
    "**/*.json": [
      "npm run format:prettier"
    ],
    "**/*.{scss,css}": [
      "npm run format:prettier",
      "npm run format:stylelint"
    ]
  },
  "prettier": {
    "bracketSameLine": true,
    "bracketSpacing": false,
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "*.{scss,css}",
        "options": {
          "singleQuote": false
        }
      },
      {
        "files": "*.json",
        "options": {
          "parser": "json-stringify"
        }
      }
    ]
  },
  "stylelint": {
    "extends": "stylelint-config-standard-scss",
    "allowEmptyInput": true,
    "rules": {
      "custom-property-pattern": null,
      "no-duplicate-selectors": null,
      "color-function-notation": null,
      "alpha-value-notation": null,
      "media-feature-name-no-unknown": null,
      "comment-empty-line-before": null,
      "declaration-empty-line-before": null,
      "property-no-vendor-prefix": null,
      "selector-attribute-quotes": null,
      "value-no-vendor-prefix": null
    },
    "overrides": [
      {
        "files": [
          "**/*.html"
        ],
        "customSyntax": "postcss-html"
      },
      {
        "files": [
          "**/*.{ts,js}"
        ],
        "customSyntax": "postcss-lit"
      }
    ]
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@blockquote/cem-to-markdown-readme": "^1.0.0",
    "@blockquote/rollup-plugin-total-bundlesize": "^2.4.0",
    "@blockquote/sass-style-template": "^5.1.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@open-wc/semantic-dom-diff": "^0.21.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "chai-a11y-axe": "^1.5.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "postcss-html": "^2.0.0",
    "postcss-lit": "^1.4.1",
    "prettier": "^3.9.6",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-node-externals": "^9.0.1",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tinyglobby": "^0.2.17",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json"
}
