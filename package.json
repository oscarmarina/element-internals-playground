{
  "name": "element-internals-playground",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "web-components",
    "custom-elements",
    "element-internals",
    "form-associated",
    "lit",
    "mixin",
    "a11y"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "analyze": "lerna run analyze --stream --concurrency 1",
    "clean": "rm package-lock.json && lerna clean",
    "clean:packages": "lerna exec -- rm -rf ./node_modules && npm run clean:packages:dev && npm run clean:packages:coverage",
    "clean:packages:coverage": "lerna exec -- rm -rf ./test/coverage",
    "clean:packages:dev": "lerna exec -- rm -rf ./dev && lerna exec -- rm -rf ./dist && lerna exec -- rm -rf ./package-lock.json",
    "eslint": "eslint --fix 'packages/**/*.*'",
    "format": "lerna run format --stream --concurrency 1",
    "format:pre-push": "npm run format -- --since",
    "lint": "npm run eslint && npm run prettier && npm run stylelint",
    "prepare": "husky",
    "prettier": "prettier --write --ignore-path .prettierignore 'packages/**/*.{js,ts,css,scss,html,json}'",
    "push": "git push --follow-tags origin main",
    "release": "npm ci && npm run test:pre-push && lerna version --no-push",
    "standard": "commit-and-tag-version",
    "stylelint": "stylelint -f verbose --ignore-path .prettierignore 'packages/**/*.{js,ts,css,scss,html}'",
    "test": "lerna run test --stream --concurrency 1 -- --run",
    "test:pre-push": "lerna run test --stream --concurrency 1 --since origin/main -- --run",
    "test:scope": "func() { lerna run test --stream --concurrency 1 --scope @blockquote-playground/${1}; }; func",
    "postversion": "npm run standard"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "@commitlint/config-workspace-scopes"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        150
      ]
    }
  },
  "lint-staged": {
    "**/*.{js,ts,html}": [
      "npm run lint"
    ],
    "**/*.json": [
      "npm run prettier"
    ],
    "**/*.{scss,css}": [
      "npm run prettier",
      "npm run stylelint"
    ]
  },
  "prettier": {
    "bracketSameLine": true,
    "bracketSpacing": false,
    "htmlWhitespaceSensitivity": "ignore",
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "*.{scss,css}",
        "options": {
          "singleQuote": false
        }
      },
      {
        "files": "*.json",
        "options": {
          "parser": "json-stringify"
        }
      }
    ]
  },
  "stylelint": {
    "extends": "stylelint-config-standard-scss",
    "allowEmptyInput": true,
    "rules": {
      "custom-property-pattern": null,
      "no-duplicate-selectors": null,
      "color-function-notation": null,
      "alpha-value-notation": null,
      "media-feature-name-no-unknown": null,
      "comment-empty-line-before": null,
      "declaration-empty-line-before": null,
      "property-no-vendor-prefix": null,
      "selector-attribute-quotes": null,
      "value-no-vendor-prefix": null
    },
    "overrides": [
      {
        "files": [
          "**/*.html"
        ],
        "customSyntax": "postcss-html"
      },
      {
        "files": [
          "**/*.{ts,js}"
        ],
        "customSyntax": "postcss-lit"
      }
    ]
  },
  "overrides": {
    "tar": "^7.5.22",
    "brace-expansion": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/config-workspace-scopes": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@typescript-eslint/parser": "^8.66.0",
    "commit-and-tag-version": "^13.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "typescript-eslint": "^8.66.0"
  },
  "commit-and-tag-version": {
    "releaseCommitMessageFormat": "chore: release {{currentTag}}",
    "commitUrlFormat": "{{host}}/oscarmarina/element-internals-playground/commit/{{hash}}",
    "compareUrlFormat": "{{host}}/oscarmarina/element-internals-playground/compare/{{previousTag}}...{{currentTag}}"
  },
  "stackblitz": {
    "startCommand": "npm --prefix packages/blk-input start"
  }
}
